{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cargo Sweep",
  "version": "0.5.4",
  "identifier": "dev.cargosweep.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cargo Sweep · Rust Target 清理器",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "backgroundColor": "#f3f5f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBOThCNTlCQjlFOEU5MzgKUldRNDZlaTVtN1dZdWluVUYxZEtTYlN6OVFKVENnK0t3ZXJyS3JuTFZYZlRPamUrc1lqZG1YTU8K",
      "endpoints": [
        "https://github.com/xwwpy/cargo-sweep/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Reclaim disk space from Rust target directories",
    "longDescription": "Cargo Sweep scans your Rust projects, reports the disk space used by Cargo target directories, and lets you clean one or many of them safely.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
